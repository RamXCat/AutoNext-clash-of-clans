<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_control_panel"
    android:padding="8dp"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AutoNext"
            android:textColor="#FFFFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:backgroundTint="#FFE57F7F"
            android:padding="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Min Gold Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIN GOLD:"
        android:textColor="#FFFFD700"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_gravity="left"
        android:layout_marginLeft="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_gold_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="-"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#424242" />

        <TextView
            android:id="@+id/tv_gold_val"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="450K"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_gold_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#424242" />
    </LinearLayout>

    <!-- Min Elixir Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIN ELIXIR:"
        android:textColor="#E040FB"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_gravity="left"
        android:layout_marginLeft="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_elixir_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="-"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#424242" />

        <TextView
            android:id="@+id/tv_elixir_val"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="450K"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_elixir_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#424242" />
    </LinearLayout>

    <!-- OCR result preview -->
    <TextView
        android:id="@+id/tv_ocr_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="G: -- | E: --"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:layout_marginBottom="6dp" />

    <!-- Status text -->
    <TextView
        android:id="@+id/tv_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:gravity="center"
        android:textColor="#FF4CAF50"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- START button -->
    <Button
        android:id="@+id/btn_start_stop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="START"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#FF4CAF50"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
